{
  "name": "atomictask-2.0",
  "version": "1.0.0",
  "private": true,
  "description": "AtomicTask 2.0 Fullstack Application",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "start": "node scripts/start.js",
    "start:server": "npm start --prefix server",
    "build": "npm run build --prefix client",
    "test": "npm run test:security --prefix server && npm run test:auth-logout --prefix server && npm run test:auth --prefix client"
  }
}
